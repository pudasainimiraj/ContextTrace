# Copy to app/.env (gitignored). Wrangler and the Vite plugin read it for local dev.
# The Worker reads these values; Vite only exposes VITE_* vars to the browser.

# Optional. Raises the GitHub REST limit from 60/hr (unauthenticated) to 5000/hr.
# A fine-grained token with no extra permissions is enough (public repos only).
# Quick fill: GITHUB_TOKEN=$(gh auth token)
GITHUB_TOKEN=

# Supabase project (Dashboard > Settings > API Keys). The secret key is server-only:
# never copy it into a VITE_* var. SUPABASE_URL is public and also set in wrangler.jsonc.
# Remote: `npx wrangler secret put SUPABASE_SECRET_KEY`.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# Only for `npm run db:push`, which applies supabase/migrations to the project; not a Worker binding.
# Use the session pooler (port 5432) and percent-encode the database password.
# Host and region: Dashboard > Connect > Session pooler.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<percent-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Workers AI, for passage embeddings. Account ID: Dashboard > Workers & Pages (right-hand
# "Account details"). Token: My Profile > API Tokens > "Workers AI" template, or a custom token
# with Workers AI Read + Edit scoped to the account. The token is named WORKERS_AI_API_TOKEN on
# purpose: a CLOUDFLARE_API_TOKEN line here would become Wrangler's own deploy credential.
# Remote: `npx wrangler secret put WORKERS_AI_API_TOKEN`.
CLOUDFLARE_ACCOUNT_ID=
WORKERS_AI_API_TOKEN=
