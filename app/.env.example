# Copy to app/.env (gitignored). Wrangler and the Vite plugin read it for local dev.
# The Worker reads these values; Vite never exposes non-VITE_* vars to the browser.

# Optional. Raises the GitHub REST limit from 60/hr (unauthenticated) to 5000/hr.
# A fine-grained token with no extra permissions is enough (public repos only).
# Quick fill: GITHUB_TOKEN=$(gh auth token)
GITHUB_TOKEN=
