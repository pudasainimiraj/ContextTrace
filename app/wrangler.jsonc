/**
 * Wrangler configuration.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "contexttrace",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-06",
	"assets": {
		"not_found_handling": "single-page-application",
		// Direct navigations to /api/* must reach the Worker, not the SPA fallback.
		"run_worker_first": ["/api/*"]
	},
	"vars": {
		// Public project URL. The secret key is a secret, not a var (see .env.example).
		"SUPABASE_URL": "https://yqnlcfpvtnnvrhdswoub.supabase.co"
	},
	"triggers": {
		// Reconciliation sweep (expired leases, lost retries) and incremental sync scheduling.
		"crons": ["*/5 * * * *"]
	},
	"queues": {
		"producers": [{ "binding": "JOBS_QUEUE", "queue": "contexttrace-jobs" }],
		// One job per consumer invocation: the free plan's CPU limit applies per invocation.
		"consumers": [{ "queue": "contexttrace-jobs", "max_batch_size": 1, "max_retries": 3 }]
	},
	// Per-IP request limits in front of the expensive endpoints (CT-39). Counters are per
	// Cloudflare location and eventually consistent; the budgets remain the hard caps.
	"ratelimits": [
		{ "name": "SEARCH_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
		{ "name": "REGISTER_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
		{ "name": "READ_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
	/**
	 * Secrets (SUPABASE_SECRET_KEY, GITHUB_TOKEN, WORKERS_AI_API_TOKEN) and the account id are not declared here.
	 * Local: app/.env (see .env.example). Remote: `npx wrangler secret put <NAME>`.
	 */
}
