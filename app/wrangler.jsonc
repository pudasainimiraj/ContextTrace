/**
 * Wrangler configuration.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "contexttrace",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-06",
	"assets": {
		"not_found_handling": "single-page-application",
		// Direct navigations to /api/* must reach the Worker, not the SPA fallback.
		"run_worker_first": ["/api/*"]
	},
	"vars": {
		// Public project URL. The secret key is a secret, not a var (see .env.example).
		"SUPABASE_URL": "https://yqnlcfpvtnnvrhdswoub.supabase.co"
	},
	"triggers": {
		// Reconciliation sweep: resend messages for expired leases and lost retries.
		"crons": ["*/5 * * * *"]
	},
	"queues": {
		"producers": [{ "binding": "JOBS_QUEUE", "queue": "contexttrace-jobs" }],
		"consumers": [{ "queue": "contexttrace-jobs", "max_batch_size": 10, "max_retries": 3 }]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
	/**
	 * Secrets (SUPABASE_SECRET_KEY, GITHUB_TOKEN) are not declared here.
	 * Local: app/.env (see .env.example). Remote: `npx wrangler secret put <NAME>`.
	 */
}
