{
  "extends": "../tsconfig.worker.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": [
      "../worker-configuration.d.ts",
      "@cloudflare/vitest-plugin/types",
      "vite/client"
    ]
  },
  "include": ["./**/*.ts", "../worker/**/*.ts", "../shared/**/*.ts"],
  // The evaluation runner is a Node script; tsconfig.node.json checks it with the Node types.
  "exclude": ["./evaluation/run.ts"]
}
